# open-design deploy env. Copied to /opt/open-design/deploy/.env by setup-open-design.sh,
# which substitutes __DESIGN_DOMAIN__ with your real Claude Design host.
#
# Subscription mode: Claude Code CLI is spawned on PATH inside the container and
# uses the mounted subscription creds. Keep ANTHROPIC_API_KEY EMPTY, otherwise
# Claude Code switches to per-token API billing instead of the subscription.

# Locally built image (ghcr.io/nexu-io/od is NOT anonymously pullable -> built from source).
OPEN_DESIGN_IMAGE=open-design-local

# Daemon binds 127.0.0.1:7456 (loopback only; Caddy fronts it).
OPEN_DESIGN_PORT=7456

# Container memory cap. Claude Code runs INSIDE the container, so raise well above
# the 384m idle default. cgroup-scoped: an OOM here kills only od, never the panel.
OPEN_DESIGN_MEM_LIMIT=1536m
NODE_OPTIONS=--max-old-space-size=384

# Exact browser origin allowed to call /api (must match the Caddy subdomain, https),
# else POST /api/* hits a 403 CORS wall. __DESIGN_DOMAIN__ is filled at install time.
OPEN_DESIGN_ALLOWED_ORIGINS=https://__DESIGN_DOMAIN__

# Trusted-reverse-proxy auth mode: no daemon token (a browser cannot attach it),
# the Caddy cookie/secret gate is the real gate for the team.
OD_API_TOKEN=
OPEN_DESIGN_DISABLE_API_AUTH=1

# Subscription, not API key. Leave EMPTY.
ANTHROPIC_API_KEY=
