# ClaudeCode server — configuration.
# Copy this file to `config.env` and fill it in, then run install.sh.
# Everything else (secrets, JWT, HTTPS certificate) is generated automatically.

# Your server IPv4 address. REQUIRED.
# Tested on Timeweb (https://timeweb.cloud/?i=144973 — the kit author's referral link),
# works on any Ubuntu 24.04 machine. 2 GB RAM and 20 GB disk are enough;
# Claude Design needs 4 GB RAM and 40 GB.
# Example: 203.0.113.45
SERVER_IP=

# Name shown at the top of the panel. Default: ClaudeCode
BRAND=ClaudeCode

# Also install Claude Design (open-design) — an AI design tool on the same
# Claude subscription. yes | no
ENABLE_DESIGN=yes

# Enable GPT image generation inside Claude Design via a ChatGPT subscription
# (Codex CLI, no OpenAI API key). Needs a separate ChatGPT login step.
# Only used when ENABLE_DESIGN=yes.  yes | no
ENABLE_CODEX=yes

# --- Advanced (leave as-is unless you know why) ---
# Where each user's private folder (jail) lives.
WORKSPACES_ROOT=/srv/cloudcli-users
